// Snow UI: native-lite visual foundation for Snow Shot.
// Keep this file dependency-free so it can be reused by settings, OCR, tray,
// history, and capture surfaces.

export global SnowTheme {
    out property <color> window-bg: #f7f7f5;
    out property <color> sidebar-bg: #f2f2f0;
    out property <color> surface-bg: #fafaf9;
    out property <color> elevated-bg: #ffffff;
    out property <color> hover-bg: #eeeeeb;
    out property <color> selected-bg: #e7e7e3;
    out property <color> pressed-bg: #dededa;

    out property <color> border: #e2e2de;
    out property <color> border-strong: #d3d4cf;

    out property <color> text-primary: #2f3136;
    out property <color> text-secondary: #6f747c;
    out property <color> text-muted: #969aa1;
    out property <color> text-on-accent: #ffffff;

    out property <color> accent: #168c82;
    out property <color> accent-hover: #12786f;
    out property <color> accent-pressed: #0e665f;
    out property <color> focus-ring: #73c8c0;
    out property <color> danger: #c94c4c;

    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-6: 24px;
    out property <length> space-8: 32px;

    out property <length> radius-xs: 4px;
    out property <length> radius-sm: 7px;
    out property <length> radius-md: 10px;
    out property <length> radius-lg: 14px;

    out property <length> caption-size: 12px;
    out property <length> body-size: 13px;
    out property <length> label-size: 14px;
    out property <length> subtitle-size: 15px;
    out property <length> title-size: 18px;

    out property <length> icon-size: 16px;
    out property <length> nav-row-height: 34px;
    out property <length> control-height: 32px;
    out property <length> toolbar-height: 42px;
    out property <length> topbar-height: 44px;
    out property <length> sidebar-width: 248px;
    out property <length> inspector-width: 360px;
}

export component SnowDivider inherits Rectangle {
    width: 1px;
    background: SnowTheme.border;
}

export component SnowSectionLabel inherits Text {
    in property <string> label;

    text: root.label;
    color: SnowTheme.text-muted;
    font-size: SnowTheme.caption-size;
    font-weight: 600;
    vertical-alignment: center;
}

export component SnowNavItem inherits Rectangle {
    in property <string> label;
    in property <string> meta;
    in property <bool> selected: false;
    callback activated();

    height: SnowTheme.nav-row-height;
    border-radius: SnowTheme.radius-sm;
    background: root.selected
        ? SnowTheme.selected-bg
        : hit.pressed
            ? SnowTheme.pressed-bg
            : hit.has-hover
                ? SnowTheme.hover-bg
                : transparent;

    HorizontalLayout {
        padding-left: SnowTheme.space-3;
        padding-right: SnowTheme.space-3;
        spacing: SnowTheme.space-2;

        Text {
            text: root.label;
            color: root.selected ? SnowTheme.text-primary : SnowTheme.text-secondary;
            font-size: SnowTheme.label-size;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Text {
            text: root.meta;
            color: SnowTheme.text-muted;
            font-size: SnowTheme.caption-size;
            vertical-alignment: center;
        }
    }

    hit := TouchArea {
        clicked => { root.activated(); }
    }
}

export component SnowIconButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> selected: false;
    callback clicked();

    width: SnowTheme.control-height;
    height: SnowTheme.control-height;
    border-radius: SnowTheme.radius-sm;
    background: root.selected
        ? SnowTheme.selected-bg
        : hit.pressed
            ? SnowTheme.pressed-bg
            : hit.has-hover
                ? SnowTheme.hover-bg
                : transparent;

    Text {
        text: root.glyph;
        color: SnowTheme.text-secondary;
        font-size: SnowTheme.icon-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    hit := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component SnowButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked();

    height: SnowTheme.control-height;
    min-width: 76px;
    border-radius: SnowTheme.radius-sm;
    border-width: root.primary ? 0px : 1px;
    border-color: SnowTheme.border-strong;
    background: root.primary
        ? hit.pressed
            ? SnowTheme.accent-pressed
            : hit.has-hover
                ? SnowTheme.accent-hover
                : SnowTheme.accent
        : hit.pressed
            ? SnowTheme.pressed-bg
            : hit.has-hover
                ? SnowTheme.hover-bg
                : SnowTheme.elevated-bg;

    Text {
        text: root.label;
        color: root.primary ? SnowTheme.text-on-accent : SnowTheme.text-primary;
        font-size: SnowTheme.body-size;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    hit := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component SnowSettingsRow inherits Rectangle {
    in property <string> title;
    in property <string> description;

    min-height: 54px;
    background: transparent;

    VerticalLayout {
        padding-top: SnowTheme.space-2;
        padding-bottom: SnowTheme.space-2;
        spacing: SnowTheme.space-1;

        Text {
            text: root.title;
            color: SnowTheme.text-primary;
            font-size: SnowTheme.label-size;
            font-weight: 500;
        }

        Text {
            text: root.description;
            color: SnowTheme.text-secondary;
            font-size: SnowTheme.caption-size;
            wrap: word-wrap;
        }
    }
}

export component SnowSettingsActionRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> action-label;
    in property <bool> primary: false;
    callback action-clicked();

    min-height: 58px;
    background: transparent;

    HorizontalLayout {
        padding-top: SnowTheme.space-2;
        padding-bottom: SnowTheme.space-2;
        spacing: SnowTheme.space-4;

        VerticalLayout {
            spacing: SnowTheme.space-1;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                color: SnowTheme.text-primary;
                font-size: SnowTheme.label-size;
                font-weight: 500;
            }

            Text {
                text: root.description;
                color: SnowTheme.text-secondary;
                font-size: SnowTheme.caption-size;
                wrap: word-wrap;
            }
        }

        SnowButton {
            label: root.action-label;
            primary: root.primary;
            clicked => { root.action-clicked(); }
        }
    }
}
