import { LineEdit, Slider } from "std-widgets.slint";
import { SnowTheme } from "../theme/snow-theme.slint";

// Layout mirrors the original project's `App-menu__left` / `selected-shape-actions`
// panel: a 200px wide vertical column of labelled sections, 12px padding and a
// 12px gap between sections.
component PanelLabel inherits Text {
    color: #595959;
    font-size: 12px;
    height: 16px;
    vertical-alignment: center;
}

component Swatch inherits Rectangle {
    in property <color> swatch;
    in property <bool> active: false;
    callback clicked();
    width: 24px;
    height: 24px;
    border-radius: 5px;
    border-width: root.active ? 2px : 1px;
    border-color: root.active ? #1677ff : area.has-hover ? #1677ff : #d9d9d9;
    background: root.swatch;
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component PanelButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();
    height: 28px;
    border-radius: SnowTheme.radius-xs;
    border-width: 1px;
    border-color: root.selected ? #1677ff : #e2e2de;
    background: root.selected ? #e6f4ff
        : area.pressed ? #d6e4ff
        : area.has-hover ? #f0f5ff
        : #fafafa;
    Text {
        text: root.label;
        color: root.selected ? #0958d9 : #262626;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component LayerButton inherits Rectangle {
    in property <int> kind: 0;
    callback clicked();
    height: 28px;
    border-radius: SnowTheme.radius-xs;
    border-width: 1px;
    border-color: #e2e2de;
    background: area.pressed ? #d6e4ff : area.has-hover ? #f0f5ff : #fafafa;

    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands:
            root.kind == 0 ? "M 12 3 V 14 M 8 10 L 12 14 L 16 10 M 4 20 H 20"
            : root.kind == 1 ? "M 12 5 V 16 M 8 12 L 12 16 L 16 12"
            : root.kind == 2 ? "M 12 19 V 8 M 8 12 L 12 8 L 16 12"
            : root.kind == 3 ? "M 12 21 V 10 M 8 14 L 12 10 L 16 14 M 4 4 H 20"
            : "M 5 7 H 19 M 10 7 V 4 H 14 V 7 M 7 7 L 8 20 H 16 L 17 7";
        fill: transparent;
        stroke: root.kind == 4 ? #c94c4c : #262626;
        stroke-width: 1.7px;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Compact numeric input matching antd `InputNumber`: a 56px text field with a
// column of small stacked up/down steppers on the right. The std SpinBox cannot
// be used here — its fluent style has a 128px min-width (two 28px side-by-side
// buttons) and overflows the 200px panel.
component NumberInput inherits Rectangle {
    in property <float> value;
    in property <int> minimum;
    in property <int> maximum;
    callback changed(float);
    callback focus-changed(bool);
    callback interaction-completed();
    property <int> display-value: Math.round(root.value);

    function commit-text() {
        if (input.text.is-float()) {
            root.changed(Math.max(root.minimum, Math.min(root.maximum, input.text.to-float())));
        }
        input.text = root.display-value;
    }
    function step(delta: int) {
        root.changed(Math.max(root.minimum, Math.min(root.maximum, root.display-value + delta)));
        root.interaction-completed();
    }

    changed value => {
        if (!input.has-focus) { input.text = root.display-value; }
    }

    width: 56px;
    height: 30px;
    border-radius: 4px;
    border-width: 1px;
    border-color: input.has-focus ? #1677ff : #d9d9d9;
    background: white;

    HorizontalLayout {
        Rectangle {
            clip: true;
            input := TextInput {
                x: 8px;
                width: parent.width - 10px;
                height: 100%;
                vertical-alignment: center;
                font-size: 13px;
                color: #262626;
                single-line: true;
                input-type: number;
                text: root.display-value;
                accepted => {
                    self.clear-focus();
                    root.interaction-completed();
                }
                changed has-focus => {
                    root.focus-changed(self.has-focus);
                    if (!self.has-focus) { root.commit-text(); }
                }
            }
        }
        Rectangle {
            width: 17px;
            Rectangle { x: 0; width: 1px; height: parent.height; background: #f0f0f0; }
            VerticalLayout {
                padding-left: 1px;
                Rectangle {
                    background: up-area.has-hover ? #f5f5f5 : transparent;
                    Path {
                        width: 10px;
                        height: 10px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: "M 6 15 L 12 9 L 18 15";
                        fill: transparent;
                        stroke: up-area.has-hover ? #1677ff : #8c8c8c;
                        stroke-width: 2.4px;
                    }
                    up-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.step(1); }
                    }
                }
                Rectangle { height: 1px; background: #f0f0f0; }
                Rectangle {
                    background: down-area.has-hover ? #f5f5f5 : transparent;
                    Path {
                        width: 10px;
                        height: 10px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: "M 6 9 L 12 15 L 18 9";
                        fill: transparent;
                        stroke: down-area.has-hover ? #1677ff : #8c8c8c;
                        stroke-width: 2.4px;
                    }
                    down-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.step(-1); }
                    }
                }
            }
        }
    }
}

// Slider paired with a numeric input, matching the original `ChangeStrokeWidthSlider`
// (antd `Slider` with `flex: 1` next to a 52px `InputNumber`).
component SliderField inherits VerticalLayout {
    in property <string> label;
    in property <float> value;
    in property <int> minimum;
    in property <int> maximum;
    in property <bool> show-input: true;
    callback changed(float);
    callback input-focus-changed(bool);
    callback interaction-completed();
    spacing: 4px;

    PanelLabel { text: root.label; }

    HorizontalLayout {
        spacing: 8px;
        height: 30px;
        Slider {
            horizontal-stretch: 1;
            minimum: root.minimum;
            maximum: root.maximum;
            value: root.value;
            changed(value) => { root.changed(value); }
            released(value) => { root.interaction-completed(); }
        }
        if root.show-input : NumberInput {
            minimum: root.minimum;
            maximum: root.maximum;
            value: root.value;
            changed(value) => { root.changed(value); }
            focus-changed(focus) => { root.input-focus-changed(focus); }
            interaction-completed => { root.interaction-completed(); }
        }
    }
}

export component AnnotationPropertyPanel inherits Rectangle {
    in property <int> active-tool: 0;
    in property <bool> has-selected-element: false;
    in property <color> stroke-color;
    in property <color> fill-color;
    in property <color> text-color;
    in-out property <string> stroke-hex;
    in-out property <string> fill-hex;
    in-out property <string> text-hex;
    in property <float> stroke-width: 6;
    in property <float> opacity-percent: 100;
    in property <float> brush-size: 22;
    in property <float> effect-strength: 55;
    in property <float> font-size: 24;
    in property <bool> bold: false;
    in property <int> text-alignment: 0;
    in property <float> serial-number: 1;
    in property <bool> selected-is-serial: false;
    in property <int> selected-annotation-tool: 0;
    in property <int> selection-count: 0;
    in property <bool> ocr-available: false;
    in-out property <string> selected-text;
    in property <bool> ocr-visible: false;
    in property <bool> ocr-busy: false;
    in property <bool> ocr-selected: false;
    in property <bool> ocr-manual-color: false;
    in-out property <int> active-color-slot: 0;
    callback color-submitted(int, string);
    callback color-alpha-changed(int, float);
    callback style-value-changed(int, float);
    callback text-submitted(string);
    callback layer-requested(int);
    callback delete-requested();
    callback ocr-copy-requested();
    callback ocr-visibility-requested(bool);
    callback ocr-auto-color-requested();
    callback drag-began();
    callback drag-moved();
    callback drag-ended();
    callback input-focus-changed(bool);
    callback interaction-completed();

    private property <float> active-color-alpha:
        root.active-color-slot == 1 ? root.fill-color.alpha / 2.55
        : root.active-color-slot == 2 ? root.text-color.alpha / 2.55
        : root.stroke-color.alpha / 2.55;
    private property <int> effective-tool:
        (root.active-tool == 0 || root.active-tool == 7
            || root.active-tool == 11 || root.active-tool == 14)
            && root.selected-annotation-tool != 0
            ? root.selected-annotation-tool
            : root.active-tool;
    private property <bool> is-shape:
        root.effective-tool == 8 || root.effective-tool == 9 || root.effective-tool == 12;
    private property <bool> is-line:
        root.effective-tool == 2 || root.effective-tool == 3;
    private property <bool> is-pen:
        root.effective-tool == 1 || root.effective-tool == 10;
    private property <bool> is-effect:
        root.effective-tool == 5 || root.effective-tool == 6;
    private property <bool> is-text: root.effective-tool == 13;
    private property <bool> is-serial: root.effective-tool == 4;

    private property <bool> show-stroke-color:
        !root.ocr-selected && (root.is-shape || root.is-line || root.is-pen || root.is-serial);
    private property <bool> show-fill-color:
        !root.ocr-selected && (root.is-shape || root.is-serial);
    private property <bool> show-text-color:
        root.ocr-selected || root.is-text || root.is-serial;
    private property <bool> show-any-color:
        root.show-stroke-color || root.show-fill-color || root.show-text-color;
    private property <bool> show-opacity:
        root.ocr-selected || (root.effective-tool != 0 && root.effective-tool != 7
            && root.effective-tool != 11);

    width: 200px;
    height: body.preferred-height;
    border-radius: SnowTheme.radius-md;
    border-width: 1px;
    border-color: #d9d9d9;
    background: white;
    drop-shadow-color: #00000026;
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 3px;

    body := VerticalLayout {
        padding: 12px;
        spacing: 12px;

        // Drag handle, mirroring the original panel's top holder bar.
        Rectangle {
            height: 16px;
            border-radius: SnowTheme.radius-xs;
            background: handle-area.has-hover ? #f0f5ff : transparent;

            for dot[index] in 12 : Rectangle {
                x: (parent.width - 40px) / 2 + mod(index, 6) * 7px;
                y: (parent.height - 9px) / 2 + floor(index / 6) * 6px;
                width: 3px;
                height: 3px;
                border-radius: 2px;
                background: handle-area.has-hover ? #1677ff : #a6a6a6;
            }

            handle-area := TouchArea {
                mouse-cursor: move;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down
                            && event.button == PointerEventButton.left) {
                        root.drag-began();
                    } else if (event.kind == PointerEventKind.move && self.pressed) {
                        root.drag-moved();
                    } else if (event.kind == PointerEventKind.up
                            || event.kind == PointerEventKind.cancel) {
                        root.drag-ended();
                    }
                }
            }
        }

        if root.selection-count > 1 : PanelLabel {
            text: "已选 " + root.selection-count + " 个对象";
            color: #595959;
        }

        if root.show-stroke-color : VerticalLayout {
            spacing: 4px;
            PanelLabel { text: "描边"; }
            HorizontalLayout {
                spacing: 6px;
                height: 24px;
                Swatch {
                    swatch: #1e1e1e;
                    clicked => { root.active-color-slot = 0; root.color-submitted(0, "#1E1E1E"); }
                }
                Swatch {
                    swatch: #f5222d;
                    clicked => { root.active-color-slot = 0; root.color-submitted(0, "#F5222D"); }
                }
                Swatch {
                    swatch: #52c41a;
                    clicked => { root.active-color-slot = 0; root.color-submitted(0, "#52C41A"); }
                }
                Swatch {
                    swatch: #1677ff;
                    clicked => { root.active-color-slot = 0; root.color-submitted(0, "#1677FF"); }
                }
                Swatch {
                    swatch: #faad14;
                    clicked => { root.active-color-slot = 0; root.color-submitted(0, "#FAAD14"); }
                }
                Rectangle { horizontal-stretch: 1; }
                Swatch {
                    swatch: root.stroke-color;
                    active: root.active-color-slot == 0;
                    clicked => { root.active-color-slot = 0; }
                }
            }
            LineEdit {
                height: 28px;
                text <=> root.stroke-hex;
                accepted(value) => { root.color-submitted(0, value); }
                changed has-focus => {
                    root.input-focus-changed(self.has-focus);
                    if (self.has-focus) { root.active-color-slot = 0; }
                }
            }
        }

        if root.show-fill-color : VerticalLayout {
            spacing: 4px;
            PanelLabel { text: "背景"; }
            HorizontalLayout {
                spacing: 6px;
                height: 24px;
                Swatch {
                    swatch: transparent;
                    clicked => { root.active-color-slot = 1; root.color-submitted(1, "#00000000"); }
                }
                Swatch {
                    swatch: #ffccc7;
                    clicked => { root.active-color-slot = 1; root.color-submitted(1, "#FFCCC7"); }
                }
                Swatch {
                    swatch: #d9f7be;
                    clicked => { root.active-color-slot = 1; root.color-submitted(1, "#D9F7BE"); }
                }
                Swatch {
                    swatch: #bae0ff;
                    clicked => { root.active-color-slot = 1; root.color-submitted(1, "#BAE0FF"); }
                }
                Swatch {
                    swatch: #fff1b8;
                    clicked => { root.active-color-slot = 1; root.color-submitted(1, "#FFF1B8"); }
                }
                Rectangle { horizontal-stretch: 1; }
                Swatch {
                    swatch: root.fill-color;
                    active: root.active-color-slot == 1;
                    clicked => { root.active-color-slot = 1; }
                }
            }
            LineEdit {
                height: 28px;
                text <=> root.fill-hex;
                accepted(value) => { root.color-submitted(1, value); }
                changed has-focus => {
                    root.input-focus-changed(self.has-focus);
                    if (self.has-focus) { root.active-color-slot = 1; }
                }
            }
        }

        if root.show-text-color : VerticalLayout {
            spacing: 4px;
            PanelLabel { text: "文字颜色"; }
            HorizontalLayout {
                spacing: 6px;
                height: 24px;
                Swatch {
                    swatch: #1e1e1e;
                    clicked => { root.active-color-slot = 2; root.color-submitted(2, "#1E1E1E"); }
                }
                Swatch {
                    swatch: #ffffff;
                    clicked => { root.active-color-slot = 2; root.color-submitted(2, "#FFFFFF"); }
                }
                Swatch {
                    swatch: #f5222d;
                    clicked => { root.active-color-slot = 2; root.color-submitted(2, "#F5222D"); }
                }
                Swatch {
                    swatch: #1677ff;
                    clicked => { root.active-color-slot = 2; root.color-submitted(2, "#1677FF"); }
                }
                Swatch {
                    swatch: #faad14;
                    clicked => { root.active-color-slot = 2; root.color-submitted(2, "#FAAD14"); }
                }
                Rectangle { horizontal-stretch: 1; }
                Swatch {
                    swatch: root.text-color;
                    active: root.active-color-slot == 2;
                    clicked => { root.active-color-slot = 2; }
                }
            }
            LineEdit {
                height: 28px;
                text <=> root.text-hex;
                accepted(value) => { root.color-submitted(2, value); }
                changed has-focus => {
                    root.input-focus-changed(self.has-focus);
                    if (self.has-focus) { root.active-color-slot = 2; }
                }
            }
        }

        if root.show-any-color : SliderField {
            label: "颜色不透明度";
            value: root.active-color-alpha;
            minimum: 0;
            maximum: 100;
            show-input: false;
            changed(value) => { root.color-alpha-changed(root.active-color-slot, value); }
            interaction-completed => { root.interaction-completed(); }
        }

        if !root.ocr-selected && (root.is-shape || root.is-line || root.is-pen) : SliderField {
            label: "线条宽度";
            value: root.stroke-width;
            minimum: 1;
            maximum: 32;
            changed(value) => { root.style-value-changed(0, value); }
            input-focus-changed(focused) => { root.input-focus-changed(focused); }
            interaction-completed => { root.interaction-completed(); }
        }

        if !root.ocr-selected && root.is-text : SliderField {
            label: "字号";
            value: root.font-size;
            minimum: 8;
            maximum: 128;
            changed(value) => { root.style-value-changed(4, value); }
            input-focus-changed(focused) => { root.input-focus-changed(focused); }
            interaction-completed => { root.interaction-completed(); }
        }

        if !root.ocr-selected && root.is-serial && root.selection-count <= 1 : VerticalLayout {
            spacing: 4px;
            PanelLabel { text: "字号"; }
            HorizontalLayout {
                spacing: 6px;
                PanelButton {
                    width: 38px;
                    label: "16";
                    selected: Math.round(root.font-size) == 16;
                    clicked => { root.style-value-changed(4, 16); }
                }
                PanelButton {
                    width: 38px;
                    label: "20";
                    selected: Math.round(root.font-size) == 20;
                    clicked => { root.style-value-changed(4, 20); }
                }
                PanelButton {
                    width: 38px;
                    label: "28";
                    selected: Math.round(root.font-size) == 28;
                    clicked => { root.style-value-changed(4, 28); }
                }
                PanelButton {
                    width: 38px;
                    label: "36";
                    selected: Math.round(root.font-size) == 36;
                    clicked => { root.style-value-changed(4, 36); }
                }
            }
        }

        if !root.ocr-selected && (root.is-pen || root.is-effect) : SliderField {
            label: "笔刷大小";
            value: root.brush-size;
            minimum: 2;
            maximum: 128;
            changed(value) => { root.style-value-changed(2, value); }
            input-focus-changed(focused) => { root.input-focus-changed(focused); }
            interaction-completed => { root.interaction-completed(); }
        }

        if root.ocr-selected || root.is-effect : SliderField {
            label: root.ocr-selected ? "模糊强度" : "强度";
            value: root.effect-strength;
            minimum: 5;
            maximum: 100;
            changed(value) => { root.style-value-changed(3, value); }
            input-focus-changed(focused) => { root.input-focus-changed(focused); }
            interaction-completed => { root.interaction-completed(); }
        }

        if root.show-opacity : SliderField {
            label: "不透明度";
            value: root.opacity-percent;
            minimum: 0;
            maximum: 100;
            show-input: false;
            changed(value) => { root.style-value-changed(1, value); }
            interaction-completed => { root.interaction-completed(); }
        }

        if !root.ocr-selected && root.is-text && root.selection-count <= 1 : VerticalLayout {
            spacing: 4px;
            PanelLabel { text: "字体"; }
            HorizontalLayout {
                spacing: 6px;
                PanelButton {
                    width: 41px;
                    label: "粗体";
                    selected: root.bold;
                    clicked => { root.style-value-changed(5, root.bold ? 0 : 1); }
                }
                PanelButton {
                    width: 41px;
                    label: "左";
                    selected: root.text-alignment == 0;
                    clicked => { root.style-value-changed(6, 0); }
                }
                PanelButton {
                    width: 41px;
                    label: "中";
                    selected: root.text-alignment == 1;
                    clicked => { root.style-value-changed(6, 1); }
                }
                PanelButton {
                    width: 41px;
                    label: "右";
                    selected: root.text-alignment == 2;
                    clicked => { root.style-value-changed(6, 2); }
                }
            }
        }

        if !root.ocr-selected && root.is-text : VerticalLayout {
            spacing: 4px;
            PanelLabel { text: "文本"; }
            LineEdit {
                height: 28px;
                text <=> root.selected-text;
                accepted(value) => { root.text-submitted(value); }
                changed has-focus => { root.input-focus-changed(self.has-focus); }
            }
        }

        if !root.ocr-selected && root.is-serial && root.selection-count <= 1 : PanelLabel {
            text: "本次截图编号：" + round(root.serial-number);
            color: #8c8c8c;
        }

        if root.ocr-available : VerticalLayout {
            spacing: 4px;
            PanelLabel { text: "OCR"; }
            HorizontalLayout {
                spacing: 6px;
                PanelButton {
                    horizontal-stretch: 1;
                    label: root.ocr-visible ? "隐藏" : "显示";
                    clicked => { root.ocr-visibility-requested(!root.ocr-visible); }
                }
                PanelButton {
                    horizontal-stretch: 1;
                    label: "复制文字";
                    clicked => { root.ocr-copy-requested(); }
                }
                if root.ocr-selected : PanelButton {
                    horizontal-stretch: 1;
                    label: "自动色";
                    selected: !root.ocr-manual-color;
                    clicked => { root.ocr-auto-color-requested(); }
                }
            }
        }

        if root.has-selected-element : VerticalLayout {
            spacing: 4px;
            PanelLabel { text: "图层"; }
            HorizontalLayout {
                spacing: 6px;
                LayerButton {
                    horizontal-stretch: 1;
                    kind: 0;
                    clicked => { root.layer-requested(0); }
                }
                LayerButton {
                    horizontal-stretch: 1;
                    kind: 1;
                    clicked => { root.layer-requested(1); }
                }
                LayerButton {
                    horizontal-stretch: 1;
                    kind: 2;
                    clicked => { root.layer-requested(2); }
                }
                LayerButton {
                    horizontal-stretch: 1;
                    kind: 3;
                    clicked => { root.layer-requested(3); }
                }
                if !root.ocr-selected : LayerButton {
                    horizontal-stretch: 1;
                    kind: 4;
                    clicked => { root.delete-requested(); }
                }
            }
        }
    }
}
