import { SnowTheme } from "../theme/snow-theme.slint";

component ToolbarHandle inherits Rectangle {
    callback drag-began(float, float);
    callback drag-moved(float, float);
    callback drag-ended();

    width: 22px;
    background: handle-area.has-hover ? #f0f5ff : transparent;
    border-radius: SnowTheme.radius-sm;

    for dot[index] in 8 : Rectangle {
        x: 5px + mod(index, 2) * 6px;
        y: (parent.height - 21px) / 2 + floor(index / 2) * 6px;
        width: 3px;
        height: 3px;
        border-radius: 2px;
        background: handle-area.has-hover ? #1677ff : #a6a6a6;
    }

    handle-area := TouchArea {
        mouse-cursor: grab;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.left) {
                root.drag-began(self.mouse-x / 1px, self.mouse-y / 1px);
            } else if (event.kind == PointerEventKind.move && self.pressed) {
                root.drag-moved(self.mouse-x / 1px, self.mouse-y / 1px);
            } else if (event.kind == PointerEventKind.up
                    || event.kind == PointerEventKind.cancel) {
                root.drag-ended();
            }
        }
    }
}

component ToolGlyph inherits Path {
    in property <int> kind: 0;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands:
        root.kind == 0 ? "M 5 3 L 18 11 L 11.5 13 L 15 20 L 11.5 21.5 L 8 14.5 L 4 19 Z"
        : root.kind == 1 ? "M 4 19 L 7 13 L 16 4 L 20 8 L 11 17 Z M 6 20 H 18"
        : root.kind == 2 ? "M 4 20 L 20 4"
        : root.kind == 3 ? "M 4 20 L 18 6 M 12 6 H 18 V 12"
        : root.kind == 4 ? "M 12 3 C 17 3 21 7 21 12 C 21 17 17 21 12 21 C 7 21 3 17 3 12 C 3 7 7 3 12 3 M 10 8 H 12 V 16 M 10 16 H 15"
        : root.kind == 5 ? "M 4 4 H 10 V 10 H 4 Z M 14 4 H 20 V 10 H 14 Z M 4 14 H 10 V 20 H 4 Z M 14 14 H 20 V 20 H 14 Z"
        : root.kind == 6 ? "M 12 3 C 9 8 5 11 5 15 C 5 19 8 21 12 21 C 16 21 19 19 19 15 C 19 11 15 8 12 3 Z"
        : root.kind == 7 ? "M 14 4 L 20 10 L 17 13 L 15 11 L 8 18 L 4 19 L 5 15 L 12 8 L 10 6 Z"
        : root.kind == 8 ? "M 4 5 H 20 V 19 H 4 Z"
        : root.kind == 9 ? "M 12 4 C 17 4 21 7.5 21 12 C 21 16.5 17 20 12 20 C 7 20 3 16.5 3 12 C 3 7.5 7 4 12 4 Z"
        : root.kind == 10 ? "M 6 16 L 15 7 L 19 11 L 10 20 H 6 Z M 4 21 H 18"
        : root.kind == 11 ? "M 8 4 L 20 16 L 15 21 H 9 L 3 15 Z M 6 12 L 13 19"
        : root.kind == 12 ? "M 12 3 L 21 12 L 12 21 L 3 12 Z"
        : root.kind == 13 ? "M 5 5 H 19 M 12 5 V 20 M 8 20 H 16"
        : "M 5 4 H 19 V 20 H 5 Z M 8 8 H 16 M 8 12 H 16 M 8 16 H 14";
    fill: transparent;
    stroke: #262626;
    stroke-width: 1.8px;
}

component HoverTip inherits Rectangle {
    in property <string> label;
    width: 66px;
    height: 24px;
    border-radius: 5px;
    background: #262626ee;
    z: 100;
    Text {
        text: root.label;
        color: white;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
component ToolButton inherits Rectangle {
    in property <string> label;
    in property <int> icon-kind: -1;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked();

    width: 36px;
    height: 34px;
    border-radius: 6px;
    border-width: root.selected ? 1px : 0px;
    border-color: #91caff;
    background: !root.enabled
        ? transparent
        : root.selected
            ? #e6f4ff
            : hit.pressed ? #d6e4ff : hit.has-hover ? #f0f5ff : transparent;

    if root.icon-kind >= 0 : ToolGlyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        kind: root.icon-kind;
        opacity: root.enabled ? 1 : 0.32;
    }

    if root.icon-kind < 0 : Text {
        text: root.label;
        color: root.enabled ? root.selected ? #0958d9 : #262626 : #bfbfbf;
        font-size: 11px;
        font-weight: root.selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if hit.has-hover && root.label != "" : HoverTip {
        x: (parent.width - self.width) / 2;
        y: -28px;
        label: root.label;
    }
    hit := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component GroupButton inherits Rectangle {
    in property <string> label;
    in property <int> icon-kind;
    in property <bool> selected;
    callback main-clicked();
    callback menu-clicked();
    callback menu-hovered();

    width: 44px;
    height: 34px;
    border-radius: 6px;
    border-width: root.selected ? 1px : 0px;
    border-color: #91caff;
    background: root.selected
        ? #e6f4ff
        : main-area.pressed || arrow-area.pressed
            ? #d6e4ff
            : main-area.has-hover || arrow-area.has-hover ? #f0f5ff : transparent;

    ToolGlyph { x: 7px; y: 8px; kind: root.icon-kind; }
    Path {
        x: 29px;
        y: 13px;
        width: 12px;
        height: 8px;
        viewbox-width: 12;
        viewbox-height: 8;
        commands: "M 2 2 L 6 6 L 10 2";
        fill: transparent;
        stroke: #8c8c8c;
        stroke-width: 1.4px;
    }
    if (main-area.has-hover || arrow-area.has-hover) && root.label != "" : HoverTip {
        x: (parent.width - self.width) / 2;
        y: -28px;
        label: root.label;
    }
    main-area := TouchArea {
        width: 29px;
        clicked => { root.main-clicked(); }
    }
    arrow-area := TouchArea {
        x: 29px;
        width: 15px;
        clicked => { root.menu-clicked(); }
        changed has-hover => { if (self.has-hover) { root.menu-hovered(); } }
    }
}

component UndoIcon inherits Path {
    in property <bool> reverse: false;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.reverse
        ? "M 15 6 L 20 11 L 15 16 M 19.5 11 H 10 C 6.5 11 4 13.5 4 17"
        : "M 9 6 L 4 11 L 9 16 M 4.5 11 H 14 C 17.5 11 20 13.5 20 17";
    fill: transparent;
    stroke: #262626;
    stroke-width: 2px;
}

component HistoryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> reverse: false;
    callback clicked();
    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: root.enabled
        ? hit.pressed ? #d6e4ff : hit.has-hover ? #f0f5ff : transparent
        : transparent;
    UndoIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        reverse: root.reverse;
        opacity: root.enabled ? 1 : 0.28;
    }
    if hit.has-hover : HoverTip {
        x: (parent.width - self.width) / 2;
        y: -28px;
        label: root.label;
    }
    hit := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component Divider inherits Rectangle {
    width: 1px;
    height: 20px;
    background: #e8e8e8;
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    callback clicked();
    width: 43px;
    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.primary ? #1677ff : root.danger ? #ffccc7 : #d9d9d9;
    background: root.primary
        ? area.pressed ? #0958d9 : area.has-hover ? #4096ff : #1677ff
        : area.pressed ? #e6f4ff : area.has-hover ? #f5f5f5 : white;
    Text {
        text: root.label;
        color: root.primary ? white : root.danger ? #cf1322 : #262626;
        font-size: 11px;
        font-weight: root.primary ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    area := TouchArea { clicked => { root.clicked(); } }
}

component InlineSubtools inherits Rectangle {
    in property <[int]> tools;
    in property <int> active-tool: 0;
    callback selected(int);
    width: root.tools.length * 34px + 4px;
    height: 34px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #d9d9d9;
    background: #f5f5f5;
    HorizontalLayout {
        padding: 2px;
        spacing: 0px;
        for tool[index] in root.tools : ToolButton {
            width: 32px;
            height: 28px;
            icon-kind: tool;
            label: tool == 8 ? "矩形" : tool == 12 ? "菱形"
                : tool == 3 ? "箭头" : tool == 2 ? "线段"
                : tool == 1 ? "画笔" : tool == 10 ? "高亮"
                : tool == 5 ? "马赛克" : "模糊";
            selected: root.active-tool == tool;
            clicked => { root.selected(tool); }
        }
    }
}

export component CaptureToolbar inherits Rectangle {
    out property <bool> menu-open: root.open-group != 0;
    in property <bool> popup-below: true;
    in property <int> active-tool: 0;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <color> active-color: #e84444;
    in property <string> color-label: "#E84444";
    in property <bool> ocr-busy: false;
    in property <string> ocr-status: "";
    in-out property <int> last-shape: 8;
    in-out property <int> last-line: 3;
    in-out property <int> last-pen: 1;
    in-out property <int> last-privacy: 5;
    callback confirm-clicked();
    callback save-clicked();
    callback pin-clicked();
    callback ocr-clicked();
    callback cancel-clicked();
    callback tool-selected(int);
    callback undo-clicked();
    callback redo-clicked();
    callback drag-began(float, float);
    callback drag-moved(float, float);
    callback drag-ended();

    private property <int> open-group: 0;

    public function dismiss-menu() { root.open-group = 0; }

    width: 840px;
    height: 48px;
    border-radius: 10px;
    border-width: 1px;
    border-color: #d9d9d9;
    background: white;
    drop-shadow-color: #0000002e;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 4px;

    ToolbarHandle {
        x: 4px;
        y: 5px;
        height: 38px;
        drag-began(local-x, local-y) => {
            root.drag-began(
                self.x / 1px + local-x,
                self.y / 1px + local-y,
            );
        }
        drag-moved(local-x, local-y) => {
            root.drag-moved(
                self.x / 1px + local-x,
                self.y / 1px + local-y,
            );
        }
        drag-ended => { root.drag-ended(); }
    }

    HorizontalLayout {
        x: 28px;
        y: 6px;
        width: parent.width - 34px;
        height: 36px;
        spacing: 2px;
        alignment: center;

        ToolButton { label: "选择"; icon-kind: 0; selected: root.active-tool == 0; clicked => { root.open-group = 0; root.tool-selected(0); } }
        Divider {}
        if root.open-group != 1 : GroupButton {
            label: "图形";
            icon-kind: root.last-shape == 12 ? 12 : 8;
            selected: root.active-tool == 8 || root.active-tool == 12;
            main-clicked => { root.open-group = 0; root.tool-selected(root.last-shape == 12 ? 12 : 8); }
            menu-clicked => { root.open-group = 1; }
        }
        if root.open-group == 1 : InlineSubtools {
            tools: [8, 12]; active-tool: root.active-tool;
            selected(tool) => { root.last-shape = tool; root.open-group = 0; root.tool-selected(tool); }
        }
        ToolButton { label: "椭圆"; icon-kind: 9; selected: root.active-tool == 9; clicked => { root.open-group = 0; root.tool-selected(9); } }
        if root.open-group != 2 : GroupButton {
            label: "线条"; icon-kind: root.last-line;
            selected: root.active-tool == 2 || root.active-tool == 3;
            main-clicked => { root.open-group = 0; root.tool-selected(root.last-line); }
            menu-clicked => { root.open-group = 2; }
        }
        if root.open-group == 2 : InlineSubtools {
            tools: [3, 2]; active-tool: root.active-tool;
            selected(tool) => { root.last-line = tool; root.open-group = 0; root.tool-selected(tool); }
        }
        if root.open-group != 3 : GroupButton {
            label: "画笔"; icon-kind: root.last-pen;
            selected: root.active-tool == 1 || root.active-tool == 10;
            main-clicked => { root.open-group = 0; root.tool-selected(root.last-pen); }
            menu-clicked => { root.open-group = 3; }
        }
        if root.open-group == 3 : InlineSubtools {
            tools: [1, 10]; active-tool: root.active-tool;
            selected(tool) => { root.last-pen = tool; root.open-group = 0; root.tool-selected(tool); }
        }
        ToolButton { label: "序号"; icon-kind: 4; selected: root.active-tool == 4; clicked => { root.open-group = 0; root.tool-selected(4); } }
        ToolButton { label: "文本"; icon-kind: 13; selected: root.active-tool == 13; clicked => { root.open-group = 0; root.tool-selected(13); } }
        if root.open-group != 4 : GroupButton {
            label: "隐私"; icon-kind: root.last-privacy;
            selected: root.active-tool == 5 || root.active-tool == 6;
            main-clicked => { root.open-group = 0; root.tool-selected(root.last-privacy); }
            menu-clicked => { root.open-group = 4; }
        }
        if root.open-group == 4 : InlineSubtools {
            tools: [5, 6]; active-tool: root.active-tool;
            selected(tool) => { root.last-privacy = tool; root.open-group = 0; root.tool-selected(tool); }
        }
        ToolButton { label: "橡皮擦"; icon-kind: 11; selected: root.active-tool == 11; clicked => { root.open-group = 0; root.tool-selected(11); } }
        ToolButton { label: "取色"; icon-kind: 7; selected: root.active-tool == 7; clicked => { root.open-group = 0; root.tool-selected(7); } }
        Divider {}
        ToolButton { width: 42px; label: root.ocr-busy ? "OCR…" : "OCR"; enabled: !root.ocr-busy; clicked => { root.open-group = 0; root.ocr-clicked(); } }
        HistoryButton { label: "撤销"; enabled: root.can-undo; clicked => { root.undo-clicked(); } }
        HistoryButton { label: "重做"; enabled: root.can-redo; reverse: true; clicked => { root.redo-clicked(); } }
        Rectangle {
            width: 26px;
            height: 26px;
            border-radius: 5px;
            border-width: 1px;
            border-color: #d9d9d9;
            background: root.active-color;
        }
        Divider {}
        ActionButton { label: "关闭"; danger: true; clicked => { root.cancel-clicked(); } }
        ActionButton { label: "贴图"; clicked => { root.pin-clicked(); } }
        ActionButton { label: "保存"; clicked => { root.save-clicked(); } }
        ActionButton { label: "复制"; primary: true; clicked => { root.confirm-clicked(); } }
    }

}