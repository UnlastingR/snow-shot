import { SnowTheme } from "../theme/snow-theme.slint";
import { SnowButton } from "buttons.slint";

export component SnowSettingsRow inherits Rectangle {
    in property <string> title;
    in property <string> description;

    min-height: 54px;
    background: transparent;

    VerticalLayout {
        padding-top: SnowTheme.space-2;
        padding-bottom: SnowTheme.space-2;
        spacing: SnowTheme.space-1;

        Text {
            text: root.title;
            color: SnowTheme.text-primary;
            font-size: SnowTheme.label-size;
            font-weight: 500;
        }

        Text {
            text: root.description;
            color: SnowTheme.text-secondary;
            font-size: SnowTheme.caption-size;
            wrap: word-wrap;
        }
    }
}

export component SnowSettingsActionRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> action-label;
    in property <bool> primary: false;
    callback action-clicked();

    min-height: 58px;
    background: transparent;

    HorizontalLayout {
        padding-top: SnowTheme.space-2;
        padding-bottom: SnowTheme.space-2;
        spacing: SnowTheme.space-4;

        VerticalLayout {
            spacing: SnowTheme.space-1;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                color: SnowTheme.text-primary;
                font-size: SnowTheme.label-size;
                font-weight: 500;
            }

            Text {
                text: root.description;
                color: SnowTheme.text-secondary;
                font-size: SnowTheme.caption-size;
                wrap: word-wrap;
            }
        }

        SnowButton {
            label: root.action-label;
            primary: root.primary;
            clicked => { root.action-clicked(); }
        }
    }
}
