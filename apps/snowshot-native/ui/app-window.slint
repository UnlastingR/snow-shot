import { SnowTheme } from "theme/snow-theme.slint";
import { SettingsShell } from "pages/settings-shell.slint";

export component AppWindow inherits Window {
    callback autostart-clicked();
    callback close-behavior-clicked();
    callback ocr-config-clicked();

    title: "Snow Shot Native Lite";
    width: 1120px;
    height: 720px;
    background: SnowTheme.window-bg;

    SettingsShell {
        autostart-clicked => { root.autostart-clicked(); }
        close-behavior-clicked => { root.close-behavior-clicked(); }
        ocr-config-clicked => { root.ocr-config-clicked(); }
    }
}
