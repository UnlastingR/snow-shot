// Framework-level visual tokens only. Components and pages consume these
// values but do not add business state to the theme layer.

export global SnowTheme {
    out property <color> window-bg: #f7f7f5;
    out property <color> sidebar-bg: #f2f2f0;
    out property <color> surface-bg: #fafaf9;
    out property <color> elevated-bg: #ffffff;
    out property <color> hover-bg: #eeeeeb;
    out property <color> selected-bg: #e7e7e3;
    out property <color> pressed-bg: #dededa;

    out property <color> border: #e2e2de;
    out property <color> border-strong: #d3d4cf;

    out property <color> text-primary: #2f3136;
    out property <color> text-secondary: #6f747c;
    out property <color> text-muted: #969aa1;
    out property <color> text-on-accent: #ffffff;

    out property <color> accent: #168c82;
    out property <color> accent-hover: #12786f;
    out property <color> accent-pressed: #0e665f;
    out property <color> focus-ring: #73c8c0;
    out property <color> danger: #c94c4c;

    out property <length> space-1: 4px;
