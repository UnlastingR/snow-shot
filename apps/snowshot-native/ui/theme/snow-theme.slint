    out property <length> radius-md: 10px;
    out property <length> radius-lg: 14px;

    out property <length> caption-size: 12px;
    out property <length> body-size: 13px;
    out property <length> label-size: 14px;
    out property <length> subtitle-size: 15px;
    out property <length> title-size: 18px;

    out property <length> icon-size: 16px;
    out property <length> nav-row-height: 34px;
    out property <length> control-height: 32px;
    out property <length> toolbar-height: 42px;
    out property <length> topbar-height: 44px;
    out property <length> sidebar-width: 248px;
    out property <length> inspector-width: 360px;
}
