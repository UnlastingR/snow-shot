export component AppTray inherits SystemTrayIcon {
    callback open-settings();
    callback capture-clicked();
    callback full-monitor-clicked();
    callback quit-requested();

    icon: @image-url("../assets/tray-icon.svg");
    title: "Snow Shot";
    tooltip: "Snow Shot · Alt+F12 截图 · Alt+F11 显示/隐藏贴图";

    clicked => { root.open-settings(); }

    Menu {
        MenuItem {
            title: "区域截图（Alt+F12）";
            activated => { root.capture-clicked(); }
        }
        MenuItem {
            title: "复制鼠标所在显示器";
            activated => { root.full-monitor-clicked(); }
        }
        MenuSeparator {}
        MenuItem {
            title: "打开设置";
            activated => { root.open-settings(); }
        }
        MenuItem {
            title: "退出";
            activated => { root.quit-requested(); }
        }
    }
}
